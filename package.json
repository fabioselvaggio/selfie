{
  "name": "oggi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:alignment": "node scripts/verify-alignment.mjs",
    "demo": "node scripts/seed-and-shoot.mjs",
    "verify:sharpness": "node scripts/verify-sharpness.mjs",
    "ios": "BASE_PATH=/ npm run build && npx cap sync ios && npx cap open ios",
    "ios:sync": "BASE_PATH=/ npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@mediapipe/tasks-vision": "^0.10.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
